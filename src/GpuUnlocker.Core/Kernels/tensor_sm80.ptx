// GPU Unlocker original register-resident MMA throughput kernel. Not a GEMM benchmark.
.version 8.0
.target sm_80
.address_size 64
.visible .entry bench_fp16(.param .u32 iterations, .param .u64 output) {
 .reg .pred %p;
 .reg .b32 %a<4>, %b<2>, %n, %i, %thread, %bid, %nt, %idx;
 .reg .b64 %ptr, %off;
 .reg .f32 %c<32>, %sum;
 ld.param.u32 %n, [iterations];
 ld.param.u64 %ptr, [output];
 mov.u32 %a0, 0x3c003c00; mov.u32 %a1, 0x3c003c00; mov.u32 %a2, 0x3c003c00; mov.u32 %a3, 0x3c003c00;
 mov.u32 %b0, 0x3c003c00; mov.u32 %b1, 0x3c003c00;
 mov.f32 %c0, 0f00000000;
 mov.f32 %c1, 0f00000000;
 mov.f32 %c2, 0f00000000;
 mov.f32 %c3, 0f00000000;
 mov.f32 %c4, 0f00000000;
 mov.f32 %c5, 0f00000000;
 mov.f32 %c6, 0f00000000;
 mov.f32 %c7, 0f00000000;
 mov.f32 %c8, 0f00000000;
 mov.f32 %c9, 0f00000000;
 mov.f32 %c10, 0f00000000;
 mov.f32 %c11, 0f00000000;
 mov.f32 %c12, 0f00000000;
 mov.f32 %c13, 0f00000000;
 mov.f32 %c14, 0f00000000;
 mov.f32 %c15, 0f00000000;
 mov.f32 %c16, 0f00000000;
 mov.f32 %c17, 0f00000000;
 mov.f32 %c18, 0f00000000;
 mov.f32 %c19, 0f00000000;
 mov.f32 %c20, 0f00000000;
 mov.f32 %c21, 0f00000000;
 mov.f32 %c22, 0f00000000;
 mov.f32 %c23, 0f00000000;
 mov.f32 %c24, 0f00000000;
 mov.f32 %c25, 0f00000000;
 mov.f32 %c26, 0f00000000;
 mov.f32 %c27, 0f00000000;
 mov.f32 %c28, 0f00000000;
 mov.f32 %c29, 0f00000000;
 mov.f32 %c30, 0f00000000;
 mov.f32 %c31, 0f00000000;
 mov.u32 %i, 0;
LOOP:
 mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c0, %c1, %c2, %c3}, {%a0, %a1, %a2, %a3}, {%b0, %b1}, {%c0, %c1, %c2, %c3};
 mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c4, %c5, %c6, %c7}, {%a0, %a1, %a2, %a3}, {%b0, %b1}, {%c4, %c5, %c6, %c7};
 mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c8, %c9, %c10, %c11}, {%a0, %a1, %a2, %a3}, {%b0, %b1}, {%c8, %c9, %c10, %c11};
 mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c12, %c13, %c14, %c15}, {%a0, %a1, %a2, %a3}, {%b0, %b1}, {%c12, %c13, %c14, %c15};
 mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c16, %c17, %c18, %c19}, {%a0, %a1, %a2, %a3}, {%b0, %b1}, {%c16, %c17, %c18, %c19};
 mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c20, %c21, %c22, %c23}, {%a0, %a1, %a2, %a3}, {%b0, %b1}, {%c20, %c21, %c22, %c23};
 mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c24, %c25, %c26, %c27}, {%a0, %a1, %a2, %a3}, {%b0, %b1}, {%c24, %c25, %c26, %c27};
 mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c28, %c29, %c30, %c31}, {%a0, %a1, %a2, %a3}, {%b0, %b1}, {%c28, %c29, %c30, %c31};
 add.u32 %i, %i, 1;
 setp.lt.u32 %p, %i, %n;
 @%p bra LOOP;
 mov.f32 %sum, 0f00000000;
 add.f32 %sum, %sum, %c0;
 add.f32 %sum, %sum, %c1;
 add.f32 %sum, %sum, %c2;
 add.f32 %sum, %sum, %c3;
 add.f32 %sum, %sum, %c4;
 add.f32 %sum, %sum, %c5;
 add.f32 %sum, %sum, %c6;
 add.f32 %sum, %sum, %c7;
 add.f32 %sum, %sum, %c8;
 add.f32 %sum, %sum, %c9;
 add.f32 %sum, %sum, %c10;
 add.f32 %sum, %sum, %c11;
 add.f32 %sum, %sum, %c12;
 add.f32 %sum, %sum, %c13;
 add.f32 %sum, %sum, %c14;
 add.f32 %sum, %sum, %c15;
 add.f32 %sum, %sum, %c16;
 add.f32 %sum, %sum, %c17;
 add.f32 %sum, %sum, %c18;
 add.f32 %sum, %sum, %c19;
 add.f32 %sum, %sum, %c20;
 add.f32 %sum, %sum, %c21;
 add.f32 %sum, %sum, %c22;
 add.f32 %sum, %sum, %c23;
 add.f32 %sum, %sum, %c24;
 add.f32 %sum, %sum, %c25;
 add.f32 %sum, %sum, %c26;
 add.f32 %sum, %sum, %c27;
 add.f32 %sum, %sum, %c28;
 add.f32 %sum, %sum, %c29;
 add.f32 %sum, %sum, %c30;
 add.f32 %sum, %sum, %c31;
 mov.u32 %thread, %tid.x;
 mov.u32 %bid, %ctaid.x;
 mov.u32 %nt, %ntid.x;
 mad.lo.u32 %idx, %bid, %nt, %thread;
 mul.wide.u32 %off, %idx, 4;
 add.u64 %ptr, %ptr, %off;
 st.global.f32 [%ptr], %sum;
 ret;
}
